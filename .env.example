# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` file (FR-051).

# --- Database (research.md §8) ---
DATABASE_URL=postgresql+psycopg://albercik:albercik@localhost:5432/albercik

# --- LLM provider (Claude via Anthropic API — Principle V) ---
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-me
LLM_ENABLED=true

# --- Embedding provider ---
# Local sentence-transformers model — no external embedding API, no
# embedding-provider API key of any kind (research.md §4/§4a).
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# --- Auth (research.md §1) ---
# REQUIRED — no default (pre-Phase-5 security checkpoint, 2026-08-17): the
# app refuses to start without this set to a non-empty value. Generate a
# real one for any non-throwaway deployment, e.g.: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRE_MINUTES=60

# --- Chunking (research.md §5) ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# --- Retrieval (research.md §6) ---
# Interim MVP default (raised from 0.75 — Phase 3 calibration checkpoint,
# 2026-08-17, research.md §6 addendum): a defense-in-depth retrieval-quality
# filter only, not proof retrieved content answers the question. See
# config.py's RETRIEVAL_RELEVANCE_THRESHOLD docstring before changing this.
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.80

# --- Provider retries (research.md §7) ---
PROVIDER_MAX_RETRIES=2

# --- Abuse / cost protection (Principle X, research.md §2-3) ---
MAX_QUESTION_LENGTH_CHARS=2000
MAX_UPLOAD_SIZE_BYTES=5000000
RATE_LIMIT_REQUESTS_PER_MINUTE=20
BUDGET_MAX_LLM_REQUESTS_PER_HOUR=200

# --- Phase 5 (User Story 3) cost/abuse controls ---
# Declared /chat request-body size (bytes) above which the request is
# rejected before it's even parsed.
MAX_CHAT_REQUEST_BODY_BYTES=16000
# Total characters of retrieved chunk content allowed into one LLM prompt.
MAX_CONTEXT_CHARS=6000
# Bounded concurrent paid-LLM calls in flight at once. Process-local — see
# infra/concurrency.py for why this needs replacing in a multi-instance
# deployment.
CHAT_CONCURRENCY_LIMIT=4
# Per-call Anthropic timeout (seconds), so a public request can never hang
# indefinitely on a stalled provider connection.
PROVIDER_TIMEOUT_SECONDS=20.0
# Number of trusted reverse proxies in front of this app. 0 (default) means
# X-Forwarded-For is never trusted and the direct TCP peer address is
# always used for rate-limiting — only raise this once actually deployed
# behind that many trusted reverse proxies (see infra/rate_limit.py).
TRUSTED_PROXY_COUNT=0
